{
	"name": "dogfight",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "npm run build --workspace dogfight-client",
		"preview": "npm run preview --workspace dogfight-client",
		"start": "npm run start --workspace dogfight-server",
		"test": "npm run test --workspaces --if-present",
		"lint": "biome check .",
		"fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8"
	}
}
