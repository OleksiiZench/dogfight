NODE_ENV=production
LOG_LEVEL=info
VERSION=dev
HOST=0.0.0.0
PORT=3000
ALLOWED_ORIGINS=https://your-app.fly.dev
MAX_CONNECTIONS_PER_IP=256
LOG_DIR=.logs
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD=4096
MESSAGES_PER_SECOND=90
TICK_RATE=30
LATENCY_MS=0
JITTER_MS=0
DROP_RATE=0
INTERPOLATION_DELAY_MS=66
JOIN_TIMEOUT_MS=5000
PING_INTERVAL_MS=15000
MAX_MISSED_PONGS=2
SLOW_CLIENT_BUFFER_BYTES=1048576
NAME_MAX_LENGTH=24
CHAT_MAX_LENGTH=240
BODY_MAX_BYTES=8192
BLOCK_MS=300
